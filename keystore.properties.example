# Copy to keystore.properties and fill in. Never commit keystore.properties or the keystore.
#
#   keytool -genkeypair -keystore keystore/upload.jks -alias upload \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the repository root.

storeFile=keystore/swing-upload.jks
storePassword=CHANGE_ME
keyAlias=swing-upload
keyPassword=CHANGE_ME
